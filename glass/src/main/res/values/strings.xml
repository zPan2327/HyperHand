    <string name="cr_title">引用与致谢</string>
    <string name="cr_subtitle">HyperHand 的界面与实现参考了这些开源项目</string>
    <string name="cr_intro">下面是源码里实际引用到的项目，点击任意一项可打开对应仓库。</string>
    <string name="cr_miuix_title">Miuix</string>
    <string name="cr_miuix_summary">compose-miuix-ui/miuix · 色彩、字号、圆角与组件规格的来源；按键映射各页直接使用其 Compose 组件 · Apache-2.0</string>
    <string name="cr_liquidglass_title">AndroidLiquidGlass</string>
    <string name="cr_liquidglass_summary">Kyant0/AndroidLiquidGlass · 液态玻璃的折射与高光思路 · Apache-2.0</string>
    <string name="cr_liquiddemo_title">LiquidDemo</string>
    <string name="cr_liquiddemo_summary">zPan2327/LiquidDemo · 液态玻璃底栏的渲染实现由此迁入，复刻自 miuix / AndroidLiquidGlass</string>
    <string name="cr_sonypods_title">SonyPods</string>
    <string name="cr_sonypods_summary">Mercury000/SonyPods · 悬浮底栏、背景模糊、概览页与关于页的版式参考</string>
    <string name="cr_kernelsu_title">KernelSU</string>
    <string name="cr_kernelsu_summary">tiann/KernelSU · 页面层级、卡片分组与信息排布参考 · GPL-3.0</string>
    <string name="cr_libxposed_title">libxposed API</string>
    <string name="cr_libxposed_summary">libxposed/api · 模块的现代 API（102）入口，并提供编译期 stub · Apache-2.0</string>
    <string name="cr_footnote">以上项目作为设计与实现参考。除按键映射各页直接使用 Miuix 组件、底栏使用 LiquidDemo 的渲染实现外，其余界面代码均由 HyperHand 自行编写。各项目版权归其作者所有，许可证以各自仓库为准。</string>
