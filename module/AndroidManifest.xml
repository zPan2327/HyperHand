<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hyperhand.tuner">

    <!-- libxposed 现代 API（102）不再使用 xposedmodule / xposedminversion 这些 meta-data：
         模块名取 android:label，简介取 android:description，
         入口在 META-INF/xposed/java_init.list，作用域在 META-INF/xposed/scope.list。 -->
    <application
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:icon="@android:drawable/ic_menu_manage"
        android:hasCode="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
